# Provider OpenAI-compatible (default: OpenRouter)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/free

# Isi dengan API key kamu. JANGAN commit file .env.
# Buat key gratis di https://openrouter.ai/keys
LLM_API_KEY=isi-api-key-di-sini

# Opsional: lokasi file memory
# CHATBOT_DATA_FILE=data/conversations.json
